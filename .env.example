# ─── PMS Backend Environment Example ───────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# Node / Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
# Format for local dev:
#   postgresql://USER:PASSWORD@localhost:5432/pms?schema=public
# Format for Prisma Accelerate example (not required):
#   prisma+postgres://accelerate.prisma-data.net/?api_key=...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pms?schema=public

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional — needed for Google sign-in & Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — for email notifications/password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@productivity.app

# Web Push (optional — for browser push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@productivity.app

# Notion (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/notion/oauth/callback

# URLs
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# AI (optional — works with OpenAI or any compatible provider)
OPENAI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_max_completion_tokens=1024
AI_TEMPERATURE=0.7

# CI / Test (used by GitHub Actions and integration tests — do NOT set in production)
TEST_DATABASE_URL=