model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  durationMin Int
  startedAt   DateTime
  completed   Boolean  @default(false)
  isBreak     Boolean  @default(false)
  taskId      String?
  projectId   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
