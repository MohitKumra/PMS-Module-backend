model UserPreference {
  userId                    String   @id
  themePreference           String   @default("SYSTEM")
  layoutPreference          String   @default("COMFORTABLE")
  calendarView              String   @default("month")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  taskView                  String   @default("board")
  notesView                 String   @default("grid")
  floatingAnimationsEnabled Boolean  @default(true)
  pageTransitionsEnabled    Boolean  @default(true)
  billingCompanyName        String?
  billingEmail              String?
  billingPhone              String?
  billingAddressLine1       String?
  billingAddressLine2       String?
  billingCityState          String?
  billingPostalCode         String?
  billingCountry            String?
  billingGstin              String?
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
