model TaskMedia {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  type      String   // "attachment" | "voice_note"
  fileName  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, type])
}