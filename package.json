{
  "name": "productivity-backend",
  "version": "1.0.0",
  "description": "Personal Productivity SaaS — Express + TypeScript + Prisma backend",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node --watch -r ts-node/register src/server.ts",
    "build": "prisma generate --config=prisma.config.ts && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=./prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma",
    "prisma:deploy": "prisma migrate deploy --schema=./prisma",
    "prisma:push": "prisma db push --schema=./prisma",
    "prisma:studio": "prisma studio --schema=./prisma",
    "prisma:format": "prisma format --schema=./prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.22.0",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/rrule": "^2.1.7",
    "@types/web-push": "^3.3.2",
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
