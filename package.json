{
  "name": "productivity-backend",
  "version": "1.0.0",
  "description": "Personal Productivity SaaS — Express + TypeScript + Prisma backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch -r ts-node/register src/server.ts",
    "build": "prisma generate --config=prisma.config.ts && tsc",
    "start": "node dist/server.js",
    "start:smoke": "node scripts/smoke-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma:validate": "prisma validate --config=prisma.config.ts",
    "prisma:generate": "prisma generate --config=prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --schema=./prisma",
    "prisma:deploy": "prisma migrate deploy --schema=./prisma",
    "prisma:push": "prisma db push --schema=./prisma",
    "prisma:studio": "prisma studio --schema=./prisma",
    "prisma:format": "prisma format --schema=./prisma",
    "migration:test": "ts-node --transpile-only scripts/test-migrations.ts",
    "migration:consistency": "ts-node --transpile-only scripts/check-migration-consistency.ts",
    "migration:destructive": "ts-node --transpile-only scripts/check-destructive-migrations.ts",
    "security:audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run prisma:validate && npm run prisma:generate && npm run test && npm run build && npm run security:audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@notionhq/client": "^5.23.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "chrono-node": "^2.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.13",
    "openai": "^7.2.0",
    "pg": "^8.22.0",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/rrule": "^2.1.7",
    "@types/web-push": "^3.3.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.5.0",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
